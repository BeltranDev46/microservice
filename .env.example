# Server configuration
PORT=4001
NODE_ENV=development
CORS_ORIGIN="http://localhost:3001,http://localhost:5173"

# Authentication secrets (replace with strong random values in your local .env)
MICROSERVICE_API_KEY="replace_with_a_strong_service_api_key"
JWT_SECRET="replace_with_at_least_32_characters_random_secret_key"
AUTH_CLIENT_ID="cuentasclaras-main-app"
AUTH_CLIENT_SECRET="replace_with_client_secret_for_token_endpoint"

# Third-party Exchange Rates API (Frankfurter - European Central Bank reference rates)
EXTERNAL_API_BASE_URL="https://api.frankfurter.dev/v1"
EXTERNAL_API_TIMEOUT_MS=6000

